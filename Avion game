// game.js — état, logique et boucle principale
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const W = canvas.width;
const H = canvas.height;
bindPointer(canvas);

const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
const overlap = (a, b) =>
  Math.abs(a.x - b.x) < (a.w + b.w) / 2 && Math.abs(a.y - b.y) < (a.h + b.h) / 2;

function loadBest() {
  try { return Number(localStorage.getItem('skyace-best')) || 0; } catch { return 0; }
}
function saveBest(v) {
  try { localStorage.setItem('skyace-best', v); } catch { /* stockage indisponible */ }
}

let state;

function newState(mode) {
  return {
    mode, // 'menu' | 'play' | 'over'
    time: 0,
    score: 0,
    best: loadBest(),
    lives: 3,
    spawnTimer: 1,
    player: { x: W / 2, y: H - 100, w: 40, h: 48, speed: 320, cooldown: 0, invincible: 0 },
    bullets: [],
    enemies: [],
    particles: [],
    clouds: state
      ? state.clouds
      : Array.from({ length: 8 }, () => ({
          x: Math.random() * W,
          y: Math.random() * H,
          w: 40 + Math.random() * 50,
          speed: 30 + Math.random() * 40,
        })),
  };
}

function explode(x, y) {
  for (let i = 0; i < 14; i++) {
    const a = Math.random() * Math.PI * 2;
    const v = 60 + Math.random() * 160;
    state.particles.push({
      x, y,
      vx: Math.cos(a) * v,
      vy: Math.sin(a) * v,
      life: 0.6,
      color: i % 2 ? '#ffb703' : '#fb5607',
    });
  }
}

function endGame() {
  const s = state;
  s.mode = 'over';
  if (s.score > s.best) {
    s.best = s.score;
    saveBest(s.best);
  }
}

function update(dt) {
  const s = state;
  s.time += dt;

  // Décor et particules avancent dans tous les modes
  for (const c of s.clouds) {
    c.y += c.speed * dt;
    if (c.y > H + 40) { c.y = -40; c.x = Math.random() * W; }
  }
  for (const q of s.particles) { q.x += q.vx * dt; q.y += q.vy * dt; q.life -= dt; }
  s.particles = s.particles.filter((q) => q.life > 0);

  if (s.mode !== 'play') {
    if (Input.consumeAction()) state = newState('play');
    return;
  }
  Input.action = false;

  // Déplacement : clavier, ou doigt/souris (l'avion se place au-dessus du doigt)
  const p = s.player;
  const a = Input.axis();
  p.x += a.x * p.speed * dt;
  p.y += a.y * p.speed * dt;
  if (Input.pointer.active) {
    const k = Math.min(1, 14 * dt);
    p.x += (Input.pointer.x - p.x) * k;
    p.y += (Input.pointer.y - 70 - p.y) * k;
  }
  p.x = clamp(p.x, p.w / 2, W - p.w / 2);
  p.y = clamp(p.y, p.h / 2, H - p.h / 2);
  p.invincible = Math.max(0, p.invincible - dt);

  // Tir
  p.cooldown -= dt;
  if (Input.fire() && p.cooldown <= 0) {
    s.bullets.push({ x: p.x, y: p.y - p.h / 2, w: 6, h: 16, vy: -620 });
    p.cooldown = 0.18;
  }

  // Apparition des ennemis : de plus en plus nombreux et rapides
  s.spawnTimer -= dt;
  if (s.spawnTimer <= 0) {
    s.enemies.push({
      x: 30 + Math.random() * (W - 60),
      y: -30,
      w: 36,
      h: 36,
      vy: 90 + s.time * 2 + Math.random() * 50,
      phase: Math.random() * Math.PI * 2,
    });
    s.spawnTimer = Math.max(0.35, 1.1 - s.time * 0.012);
  }

  for (const b of s.bullets) b.y += b.vy * dt;
  for (const e of s.enemies) {
    e.y += e.vy * dt;
    e.x += Math.sin(s.time * 2 + e.phase) * 50 * dt;
  }

  // Tirs contre ennemis
  for (const b of s.bullets) {
    for (const e of s.enemies) {
      if (!b.dead && !e.dead && overlap(b, e)) {
        b.dead = true;
        e.dead = true;
        s.score += 10;
        explode(e.x, e.y);
      }
    }
  }

  // Ennemis contre joueur
  for (const e of s.enemies) {
    if (!e.dead && p.invincible <= 0 && overlap(p, e)) {
      e.dead = true;
      s.lives -= 1;
      p.invincible = 1.5;
      explode(p.x, p.y);
      if (s.lives <= 0) endGame();
    }
  }

  s.bullets = s.bullets.filter((b) => !b.dead && b.y > -20);
  s.enemies = s.enemies.filter((e) => !e.dead && e.y < H + 40);
}

let last = performance.now();
function frame(now) {
  const dt = Math.min(0.05, (now - last) / 1000);
  last = now;
  update(dt);
  draw(ctx, state);
  requestAnimationFrame(frame);
}

state = newState('menu');
requestAnimationFrame(frame);
state = newState('menu');
requestAnimationFrame(frame);
